# Copy to .env.local and fill in your values. .env.local is gitignored.

# --- For `npm run dev` (Vite reads these via import.meta.env) ---
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-publishable-key

# --- For `npm run sync-staging` (direct Postgres connection strings) ---
# Found in Supabase dashboard → Connect → PostgreSQL → Direct connection.
# Replace [YOUR-PASSWORD] with your actual database password.
PROD_DB_URL=postgresql://postgres:PASSWORD@db.your-prod-project.supabase.co:5432/postgres
STAGING_DB_URL=postgresql://postgres:PASSWORD@db.your-staging-project.supabase.co:5432/postgres
